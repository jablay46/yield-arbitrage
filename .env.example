# Base RPC (optional — public endpoint is the default)
BASE_RPC_URL=https://mainnet.base.org

# WebSocket endpoint (optional — enables Flashblocks-speed reads/polls)
BASE_WS_URL=

# Deployed LoopingExecutor address (required for any on-chain interaction)
EXECUTOR_ADDRESS=

# Owner key — REQUIRED only for live mode (DRY_RUN=false). Never commit a real key.
EXECUTOR_PRIVATE_KEY=

# Loop parameters
MARGIN_ASSET=0x4200000000000000000000000000000000000006
MARGIN_AMOUNT=1000000000000000000
LEVERAGE=2

# Safety
DRY_RUN=true
AUTO_TRADE=false
MIN_NET_APY_BPS=50
POLL_INTERVAL_MS=15000

# Base Flashblocks: reads/simulation against the ~200ms preconfirmed block
USE_PENDING_BLOCK=true


# Deployer key for `forge script` (same warning: never commit)
DEPLOYER_PRIVATE_KEY=

# Optional: Basescan verification
BASESCAN_API_KEY=
