# ─── RPC / network ──────────────────────────────────────────────
# Base RPC (optional — public endpoint is the default; RPC_URL is an alias)
BASE_RPC_URL=https://mainnet.base.org

# WebSocket endpoint (optional — enables Flashblocks-speed reads/polls)
BASE_WS_URL=

# Base Flashblocks: reads/simulation against the ~200ms preconfirmed block
USE_PENDING_BLOCK=true

# ─── Executor / wallet ──────────────────────────────────────────
# Deployed LoopingExecutor address (required for any on-chain interaction)
EXECUTOR_ADDRESS=

# Owner key — REQUIRED only for live mode (DRY_RUN=false). Never commit a real key.
EXECUTOR_PRIVATE_KEY=

# ─── Loop parameters ────────────────────────────────────────────
# Margin token address (default: WETH on Base)
MARGIN_ASSET=0x4200000000000000000000000000000000000006
# Margin amount in smallest units (1e18 = 1 WETH)
MARGIN_AMOUNT=1000000000000000000
# Leverage: 2, 3, or 5
LEVERAGE=2
# Minimum yearly net yield on margin, in basis points (50 = 0.5%)
MIN_NET_APY_BPS=50

# ─── Safety / risk ──────────────────────────────────────────────
# Simulate only (no transactions) when true
DRY_RUN=true
# Open the best loop automatically when true
AUTO_TRADE=false
# Minimum health factor as 18-decimal WAD (1.05e18 = 1.05)
MIN_HEALTH_FACTOR_WAD=1050000000000000000
# Warn when health factor drops below this (1.20e18 = 1.20)
HEALTH_FACTOR_WARN_WAD=1200000000000000000
# Emergency deleverage threshold (1.10e18 = 1.10)
HEALTH_FACTOR_CRITICAL_WAD=1100000000000000000
# Max margin size in USD before opening is blocked
MAX_MARGIN_USD=50000

# ─── Loop control ───────────────────────────────────────────────
# How often rates are refreshed / candidates re-ranked (ms)
POLL_INTERVAL_MS=30000
# How often the on-chain health factor is polled (ms)
HEALTH_CHECK_INTERVAL_MS=60000
# Cooldown after an open before another is attempted (ms)
COOLDOWN_MS=60000
# Oracle price cache lifetime — avoids an RPC per cycle (ms)
PRICE_CACHE_TTL_MS=30000

# ─── Gas ────────────────────────────────────────────────────────
# Hard cap on total gas price (base + priority) in gwei
MAX_GAS_PRICE_GWEI=50
# Priority fee cap in gwei
PRIORITY_FEE_GWEI=0.1
# Buffer added to estimated gas limit (%)
GAS_BUFFER_PERCENT=20

# ─── Storage / logging ──────────────────────────────────────────
# Path to the persisted PnL ledger
PNL_PATH=./data/pnl.json
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info


# ─── Deploy / verification (forge script) ───────────────────────
# Deployer key for `forge script` (same warning: never commit)
DEPLOYER_PRIVATE_KEY=

# Optional: Basescan verification
ETHERSCAN_API_KEY=
