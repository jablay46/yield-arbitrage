# RPC URLs
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Private Key (for deployments - DO NOT COMMIT)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Wallet for arbitrage execution
ARBITER_PRIVATE_KEY=your_arbitrer_private_key

# Database
DATABASE_URL=./data/arbitrage.db

# Redis (optional for production)
REDIS_URL=redis://localhost:6379

# Flashloan Providers
AAVE_POOL_V3_ADDRESS=0x... # Base Aave V3 Pool
MORPHO_ADDRESS=0x... # Morpho on Base
MOONWELL_POOL_ADDRESS=0x... # Moonwell on Base

# Gas Settings
MAX_GAS_PRICE_GWEI=50
GAS_BUFFER_PERCENT=20
